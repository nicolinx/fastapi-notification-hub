# Copy to .env and adjust. Never commit .env.
APP_ENV=development

# PostgreSQL (async URL for the API, sync URL for the Celery worker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notification_hub
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/notification_hub

# Redis (Celery broker and result backend)
REDIS_URL=redis://localhost:6379/0
